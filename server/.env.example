# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/lightnoteai?retryWrites=true&w=majority

# AI provider: gemini | openai | qwen
AI_PROVIDER=gemini

# Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Qwen (Alibaba Cloud — OpenAI-compatible)
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Server port
PORT=5000

# FFmpeg — if not in PATH, set the full path to the ffmpeg binary
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
